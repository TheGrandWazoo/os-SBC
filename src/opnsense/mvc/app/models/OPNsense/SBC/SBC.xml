<model>
    <mount>//OPNsense/SBC</mount>
    <version>1.0.0</version>
    <description>Session Border Controller (Kamailio and rtpproxy)</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <external_interface type="InterfaceField">
                <Default>wan</Default>
                <Required>Y</Required>
            </external_interface>
            <internal_interface type="InterfaceField">
                <Default>lan</Default>
                <Required>Y</Required>
            </internal_interface>
            <sip_port type="PortField">
                <Default>5060</Default>
                <Required>Y</Required>
            </sip_port>
            <rtp_port_min type="IntegerField">
                <Default>10000</Default>
                <Required>Y</Required>
                <MinimumValue>1024</MinimumValue>
                <MaximumValue>65535</MaximumValue>
                <ValidationMessage>Choose a port between 1024 and 65535.</ValidationMessage>
            </rtp_port_min>
            <rtp_port_max type="IntegerField">
                <Default>20000</Default>
                <Required>Y</Required>
                <MinimumValue>1024</MinimumValue>
                <MaximumValue>65535</MaximumValue>
                <ValidationMessage>Choose a port between 1024 and 65535.</ValidationMessage>
            </rtp_port_max>
        </general>
    </items>
</model>
